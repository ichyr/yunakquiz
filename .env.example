# Template for .env: copy to .env and fill in real secrets only. .env is gitignored.
# Non-secret local defaults live in the committed .env.development; the API scripts
# load it first and .env second, so a key set here overrides the same key there.
# No secrets are needed yet. Add each one as KEY=value, for example:
# SOME_API_KEY=

# Mail (SES). Non-secret dev defaults (LocalStack) are in .env.development.
# Production: set AWS_REGION and MAIL_FROM (a verified SES identity), leave AWS_ENDPOINT_URL
# unset, and use an IAM role instead of AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# AWS_ENDPOINT_URL=
# AWS_REGION=
# MAIL_FROM=

# Passwords. Production: one secret per version, first entry is current, never reuse the dev one.
# PASSWORD_PEPPERS=v1:<at least 16 random characters>
# WEB_BASE_URL=https://example.org
# CORS_ORIGINS=https://example.org

# Registration: open (default) or closed. In closed, self-registration answers 403 and only Admins make Accounts.
# REGISTRATION_MODE=open

# First Admin, for `pnpm --filter @yunakquiz/api db:seed:admin`. Does nothing once any Admin exists.
# The password must pass the same rules as registration. Remove these after the first run.
# FIRST_ADMIN_EMAIL=
# FIRST_ADMIN_NAME=
# FIRST_ADMIN_PASSWORD=

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": [
      "Bash(claude -p*)",
      "Bash(claude --print*)",
      "Bash(* claude -p*)",
      "Bash(* claude --print*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git clean -x*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Read(//**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.claude.json)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.github/**)",
      "Edit(apps/*/.claude/**)",
      "Edit(../../.claude/settings.json)",
      "Edit(../../.claude/settings.local.json)",
      "Edit(../../.claude/hooks/**)",
      "Edit(../../.github/**)",
      "Edit(../web/.claude/**)",
      "Edit(../api/.claude/**)"
    ],
    "ask": [
      "Bash(git push --force-with-lease*)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git restore --staged --worktree*)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "docker *",
      "pnpm db:up",
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm",
        "~/.local/share/pnpm",
        "~/Library/Caches/ms-playwright",
        "~/.cache/ms-playwright"
      ],
      "denyWrite": [
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/hooks",
        ".github",
        "apps/web/.claude",
        "apps/api/.claude"
      ],
      "denyRead": [
        "/**/.env.*"
      ],
      "allowRead": [
        "**/.env.example",
        "**/.env.development",
        "../../.env.example",
        "../../.env.development"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/.claude/hooks/git-guard.mjs\"",
            "onFailure": "block",
            "statusMessage": "Checking git guardrails"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/.claude/hooks/guardrail-lock.mjs\"",
            "onFailure": "block",
            "statusMessage": "Checking guardrail files"
          }
        ]
      }
    ]
  }
}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git clean -x*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ],
    "ask": [
      "Bash(git push --force-with-lease*)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git restore --staged --worktree*)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/.claude/hooks/git-guard.mjs\"",
            "onFailure": "block",
            "statusMessage": "Checking git guardrails"
          }
        ]
      }
    ]
  }
}

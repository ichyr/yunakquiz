# Non-secret defaults for local development. Committed on purpose.
# Never put a secret here: secrets go in the gitignored .env (see .env.example),
# whose values override the ones below.
DATABASE_URL=postgres://yunakquiz:yunakquiz@localhost:5432/yunakquiz
# Mail goes to LocalStack SES (docker compose). Production leaves AWS_ENDPOINT_URL unset.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
MAIL_FROM=noreply@yunakquiz.test
# Dev-only pepper for password hashes (first entry is current). Production sets its own secret,
# never committed. See docs/password-hashing.md.
PASSWORD_PEPPERS=v1:dev-only-pepper-not-a-secret-0001
# Where mailed links point.
WEB_BASE_URL=http://localhost:5173

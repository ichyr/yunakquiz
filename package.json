{
  "name": "yunakquiz",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:guardrails && pnpm -r test",
    "test:guardrails": "node --test \".claude/hooks/*.test.mjs\"",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait",
    "db:seed": "pnpm --filter @yunakquiz/api db:seed",
    "dev:api": "pnpm --filter @yunakquiz/api dev",
    "check:stories": "node scripts/check-stories.mjs",
    "dev:web": "pnpm --filter @yunakquiz/web dev",
    "build:web": "pnpm --filter @yunakquiz/web build",
    "storybook": "pnpm --filter @yunakquiz/web storybook",
    "build-storybook": "pnpm --filter @yunakquiz/web build-storybook",
    "test:e2e": "pnpm --filter @yunakquiz/web test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
